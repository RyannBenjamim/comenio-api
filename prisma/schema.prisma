generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instituicao {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  telefone  String
  cnpj      String   @unique
  endereco  String

  usuarios  Usuario[]
  turmas    Turma[]
  materias  Materia[]
  aulas     Aula[]
  comunidades Comunidade[]
  atividades Atividade[]
  feeds     Feed[]
  posts     Post[]
  respostas Resposta[]
  curtidas  Curtida[]
  resolucoes Resolucao[]
  correcoes  Correcao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Superadmin {
  id                String    @id @default(uuid())
  primeiroNome      String
  sobrenome         String
  email             String     @unique
  senha             String
  dataNascimento    DateTime
  telefone          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id                String    @id @default(uuid())
  instituicaoId     String
  primeiroNome      String
  sobrenome         String
  nickname          String    @unique
  bio               String?
  email             String     @unique
  senha             String
  dataNascimento    DateTime
  telefone          String
  fotoPerfilCaminho String?
  fotoPerfilUrl     String?
  cargo             Cargo

  instituicao       Instituicao @relation(fields: [instituicaoId], references: [id])

  moderador         Moderador?
  professor         Professor?
  responsavel       Responsavel?
  aluno             Aluno?

  posts             Post[]
  respostas         Resposta[]
  curtidas          Curtida[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Cargo {
  ADMIN
  MODERADOR
  PROFESSOR
  ALUNO
  RESPONSAVEL
}

model Moderador {
  userId  String @id
  setor   String
  usuario Usuario @relation(fields: [userId], references: [id])
}

model Professor {
  userId         String  @id
  matricula      String?
  statusContrato StatusContrato
  cargaHoraria   Int

  usuario    Usuario @relation(fields: [userId], references: [id])
  aulas      Aula[]
  correcoes  Correcao[]
  atividades    Atividade[]
}

enum StatusContrato {
  ATIVO
  SUSPENSO
  AFASTADO
  ENCERRADO
}

model Responsavel {
  userId             String  @id
  grauParentesco     String
  cpf                String
  usuario            Usuario @relation(fields: [userId], references: [id])
  alunosResponsaveis AlunosResponsavel[]
}

model Aluno {
  userId             String  @id
  matricula          String?
  turmaId            String
  statusMatricula    String

  usuario            Usuario @relation(fields: [userId], references: [id])
  turma              Turma   @relation(fields: [turmaId], references: [id])

  alunosResponsaveis AlunosResponsavel[]
  resolucoes         Resolucao[]
}

model AlunosResponsavel {
  alunoId       String
  responsavelId String

  aluno         Aluno       @relation(fields: [alunoId], references: [userId])
  responsavel   Responsavel @relation(fields: [responsavelId], references: [userId])

  @@id([alunoId, responsavelId])
}

enum Periodo {
  MANHA
  TARDE
  NOITE
}

model Turma {
  id             String @id @default(uuid())
  instituicaoId  String
  titulo         String
  periodo        Periodo

  instituicao    Instituicao @relation(fields: [instituicaoId], references: [id])

  alunos         Aluno[]
  aulas          Aula[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Materia {
  id            String @id @default(uuid())
  instituicaoId String
  titulo        String
  tipo          MateriaTipo

  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])

  aulas         Aula[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MateriaTipo {
  EXATAS
  HUMANAS
  NATUREZA
  LINGUAGENS
}

model Aula {
  id            String @id @default(uuid())
  instituicaoId String
  professorId   String
  turmaId       String
  materiaId     String

  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])
  professor     Professor   @relation(fields: [professorId], references: [userId])
  turma         Turma       @relation(fields: [turmaId], references: [id])
  materia       Materia     @relation(fields: [materiaId], references: [id])

  comunidade    Comunidade?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professorId, turmaId, materiaId])
}

model Comunidade {
  id            String @id @default(uuid())
  instituicaoId String
  titulo        String
  aulaId        String @unique

  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])
  aula          Aula     @relation(fields: [aulaId], references: [id])

  atividades    Atividade[]
  posts         Post[]
  respostas     Resposta[]
  curtidas      Curtida[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Atividade {
  id            String @id @default(uuid())
  instituicaoId String

  titulo        String
  conteudo      String
  pdfCaminho    String?
  dataInicio    DateTime
  dataFim       DateTime

  professorId   String
  professor     Professor @relation(fields: [professorId], references: [userId])

  comunidadeId  String
  comunidade    Comunidade @relation(fields: [comunidadeId], references: [id])

  resolucoes    Resolucao[]

  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resolucao {
  id            String @id @default(uuid())
  instituicaoId String
  alunoId       String
  atividadeId   String
  conteudo      String
  pdfCaminho    String?

  aluno         Aluno     @relation(fields: [alunoId], references: [userId])
  atividade     Atividade @relation(fields: [atividadeId], references: [id])
  correcoes     Correcao[]

  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Correcao {
  id            String @id @default(uuid())
  instituicaoId String
  resolucaoId   String
  professorId   String
  conteudo      String
  pdfCaminho    String?

  resolucao     Resolucao @relation(fields: [resolucaoId], references: [id])
  professor     Professor @relation(fields: [professorId], references: [userId])

  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feed {
  id            String @id @default(uuid())
  instituicaoId String
  titulo        String
  tipoPerfil    Cargo

  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])

  posts         Post[]
  respostas     Resposta[]
  curtidas      Curtida[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id            String @id @default(uuid())
  instituicaoId String

  conteudo      String
  fotoCaminho   String?
  fotoUrl       String?

  userId        String
  feedId        String?
  comunidadeId  String?

  user          Usuario     @relation(fields: [userId], references: [id])
  feed          Feed?       @relation(fields: [feedId], references: [id])
  comunidade    Comunidade? @relation(fields: [comunidadeId], references: [id])

  respostas     Resposta[]
  curtidas      Curtida[]

  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resposta {
  id            String @id @default(uuid())
  instituicaoId String
  conteudo      String

  fotoCaminho   String?
  fotoUrl       String?

  userId        String
  postId        String?
  respostaId    String?

  feedId        String?
  comunidadeId  String?

  user          Usuario @relation(fields: [userId], references: [id])
  post          Post?   @relation(fields: [postId], references: [id])

  feed          Feed?       @relation(fields: [feedId], references: [id])
  comunidade    Comunidade? @relation(fields: [comunidadeId], references: [id])

  respostas     Resposta[] @relation("RespostasFilhas")
  respostaPai   Resposta?  @relation("RespostasFilhas", fields: [respostaId], references: [id])

  curtidas      Curtida[]
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Curtida {
  id            String @id @default(uuid())
  instituicaoId String

  userId        String
  postId        String?
  respostaId    String?

  feedId        String?
  comunidadeId  String?

  user          Usuario   @relation(fields: [userId], references: [id])
  post          Post?     @relation(fields: [postId], references: [id])
  resposta      Resposta? @relation(fields: [respostaId], references: [id])

  feed          Feed?       @relation(fields: [feedId], references: [id])
  comunidade    Comunidade? @relation(fields: [comunidadeId], references: [id])

  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@unique([userId, respostaId])
}



